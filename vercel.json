{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/downloads/:match*",
      "destination": "/downloads/:match*"
    },
    {
      "source": "/((?!downloads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"my_sadhna.apk\"" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
